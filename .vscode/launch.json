{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Program",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "args": [
        "convert",
        "./src/tests/clash.yaml",
        "./src/tests/sing-box.json",
        "--experimental.cachefile.enabled",
        "true",
        "--experimental.cachefile.path",
        "cache.db",
        "--experimental.cachefile.cacheid",
        "id",
        "--experimental.clashapi.externalcontroller",
        "127.0.0.1:9090",
        "--experimental.clashapi.externalui",
        "ui",
        "--experimental.clashapi.secret",
        "123456789",
        "--outbound.domainresolver.tag",
        "bootstrap",
        "--outbound.selector.default",
        "tuic",
        "--outbound.selector.filter",
        "tuic",
        "--outbound.selector.tag",
        "selector-a,selector-t",
        "--mergeable",
        "./src/tests/sing-box-mergeable.json",
      ],
      "runtimeArgs": [
        "--permission",
        "--allow-fs-read=./node_modules/",
        "--allow-fs-read=./src/",
        "--allow-fs-write=./src/tests/sing-box.json"
      ],
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    }
  ]
}
